{
  "last_ping": 1795859247.2644386
}name: Rappel bump

on:
  schedule:
    - cron: "7,22,37,52 * * * *"   # filet de sécurité ; le déclencheur principal est cron-job.org
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: bump-reminder
  cancel-in-progress: false

jobs:
  remind:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Envoyer le rappel si c'est l'heure
        env:
          BUMP_WEBHOOK_URL: ${{ secrets.BUMP_WEBHOOK_URL }}
          BUMP_ROLE_ID: ${{ secrets.BUMP_ROLE_ID }}
          BUMP_COMMAND_ID: ${{ secrets.BUMP_COMMAND_ID }}
          BUMP_INTERVAL_MIN: ${{ secrets.BUMP_INTERVAL_MIN }}
          BUMP_QUIET_FROM: ${{ secrets.BUMP_QUIET_FROM }}
          BUMP_QUIET_TO: ${{ secrets.BUMP_QUIET_TO }}
          BUMP_DELETE_PREVIOUS: ${{ secrets.BUMP_DELETE_PREVIOUS }}
        run: python3 bump_reminder.py

      - name: Sauvegarder l'heure du dernier rappel
        run: |
          if [ -n "$(git status --porcelain bump_state.json)" ]; then
            git config user.name "bump-reminder"
            git config user.email "bump-reminder@users.noreply.github.com"
            git add bump_state.json
            git commit -m "Dernier rappel de bump"
            git push
          fi
